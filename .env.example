# Copy this file to .env and fill in your Supabase project values.
#
# Local development (`npm run db:start`): the CLI prints both values —
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<"Publishable" / "anon" key from `npx supabase status`>
#
# Hosted project: Supabase Dashboard → Project Settings → API.
#   Use the bare project URL — https://<ref>.supabase.co — not the …/rest/v1 endpoint.
#
# Only the public URL and the anon/publishable key belong here.
# NEVER put the service-role / secret key in a VITE_ variable — it would ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
