{
  "name": "tripsplit",
  "private": true,
  "version": "0.1.0",
  "description": "TripSplit — Travel together. Track together. Split smarter.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/upper-drive.mjs vite",
    "build": "tsc -b && node scripts/upper-drive.mjs vite build",
    "preview": "node scripts/upper-drive.mjs vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node scripts/upper-drive.mjs vitest run",
    "test:watch": "node scripts/upper-drive.mjs vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local --schema tripsplit > src/types/database.ts",
    "db:migrate:remote": "node scripts/db-migrate-remote.mjs",
    "db:status:remote": "node scripts/db-migrate-remote.mjs --status",
    "db:test:remote": "node scripts/db-test-remote.mjs",
    "db:types:remote": "supabase gen types typescript --linked --schema tripsplit > src/types/database.ts",
    "db:advisors:remote": "supabase db advisors --linked"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
